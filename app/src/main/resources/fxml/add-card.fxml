<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unicam.flashcards.view.AddCardController"
      spacing="18"
      prefWidth="480"
      style="-fx-background-color: linear-gradient(to bottom right, #FFFFFF, #F8FAFC);">

    <padding>
        <Insets top="28" right="30" bottom="28" left="30"/>
    </padding>

    <VBox spacing="4">
        <Label text="Nuova flashcard"
               style="-fx-font-size: 26px;
                      -fx-font-weight: 900;
                      -fx-text-fill: #111827;"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Argomento"
               style="-fx-font-size: 13px;
                      -fx-font-weight: 800;
                      -fx-text-fill: #374151;"/>

        <TextField fx:id="argumentTextField"
                   promptText="Argomento"
                   style="-fx-background-color: white;
                          -fx-background-radius: 14;
                          -fx-border-color: #E5E7EB;
                          -fx-border-radius: 14;
                          -fx-border-width: 1.5;
                          -fx-padding: 12;
                          -fx-font-size: 14px;"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Dettagli"
               style="-fx-font-size: 13px;
                      -fx-font-weight: 800;
                      -fx-text-fill: #374151;"/>

        <TextArea fx:id="detailsTextArea"
                  promptText="Scrivi qui la spiegazione"
                  wrapText="true"
                  prefRowCount="7"
                  style="-fx-background-color: white;
                         -fx-background-radius: 14;
                         -fx-border-color: #E5E7EB;
                         -fx-border-radius: 14;
                         -fx-border-width: 1.5;
                         -fx-padding: 10;
                         -fx-font-size: 14px;"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button text="Annulla"
                onAction="#onCancelClicked"
                style="-fx-background-color: #F3F4F6;
                       -fx-text-fill: #374151;
                       -fx-font-weight: 800;
                       -fx-background-radius: 999;
                       -fx-padding: 10 18 10 18;
                       -fx-cursor: hand;"/>

        <Button text="Salva"
                onAction="#onSaveClicked"
                style="-fx-background-color: #4F46E5;
                       -fx-text-fill: white;
                       -fx-font-weight: 900;
                       -fx-background-radius: 999;
                       -fx-padding: 10 20 10 20;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.35), 14, 0.25, 0, 6);"/>
    </HBox>

</VBox>